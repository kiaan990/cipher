{
  "name": "voice-orb",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time voice conversation with Claude, visualised as a glowing orb.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "dream": "tsx server/dream-cli.ts",
    "test": "node tests/run.mjs",
    "test:dream": "tsx --test tests/dream.test.ts",
    "test:models": "tsx tests/first-token.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "onnxruntime-node": "1.21.0",
    "three": "^0.170.0",
    "tsx": "^4.19.2",
    "undici": "^7.30.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
