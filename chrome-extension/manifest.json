{
  "manifest_version": 3,
  "name": "Cipher Bridge",
  "version": "1.0.0",
  "description": "Lets the Cipher app on this Mac read and use your Chrome tabs when you ask it to.",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Cipher Bridge", "default_popup": "popup.html" },
  "minimum_chrome_version": "116"
}
