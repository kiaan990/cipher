# Copy this file to .env and fill in your keys. Never commit .env.

# Required
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Optional: ElevenLabs voice. Defaults to "Laura" (FGY2WhTYpPnrIDTdsKH5), which works on the free plan.
ELEVENLABS_VOICE_ID=

# Optional overrides (defaults shown)
# ANTHROPIC_MODEL=claude-haiku-4-5
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# DEEPGRAM_MODEL=nova-3
# PORT=3000
# OPEN_BROWSER=true
# ELEVENLABS_STABILITY=0.38
# ELEVENLABS_STYLE=0.2
# SMART_TURN=on
# SMART_TURN_MAX_WAIT_MS=1400
# BACKCHANNELS=on

# Optional: dreaming. While you're away, Cipher re-reads recent conversations, checks
# what it remembered against what was said, and tidies its memory. DREAM=off stops it.
# It waits for one run by hand first: npm run dream -- --dry
# It uses ANTHROPIC_API_KEY, and a stronger model than the conversation does.
# DREAM=on
# DREAM_MODEL=claude-opus-5-5
# DREAM_EFFORT=high
# DREAM_IDLE_MIN=20
# DREAM_MIN_EXCHANGES=6
# DREAM_MAX_PER_DAY=8
# TRANSCRIPT_KEEP_DAYS=365

# Optional: your cloud server (kiaan-cloud). Its MCP address and access token.
# Cipher can look things up there, and make changes after you say yes.
KIAAN_MCP_URL=
KIAAN_MCP_TOKEN=
