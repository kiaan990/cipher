# Copy this file to .env and fill in your keys. Never commit .env.

# Required
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Optional: ElevenLabs voice. Defaults to "Laura" (FGY2WhTYpPnrIDTdsKH5), which works on the free plan.
ELEVENLABS_VOICE_ID=

# Optional overrides (defaults shown)
# ANTHROPIC_MODEL=claude-haiku-4-5
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# DEEPGRAM_MODEL=nova-3
# PORT=3000
# OPEN_BROWSER=true
# ELEVENLABS_STABILITY=0.38
# ELEVENLABS_STYLE=0.2
# SMART_TURN=on
# SMART_TURN_MAX_WAIT_MS=1400
# BACKCHANNELS=on

# Optional: your cloud server (kiaan-cloud). Its MCP address and access token.
# Cipher can look things up there, add and change things straight away, and delete
# only after you say yes.
KIAAN_MCP_URL=
KIAAN_MCP_TOKEN=
# CLOUD_CONFIRM=deletes          # "all" to be asked before every change, not just deletes
# MUSE_LINK=on                   # answer messages Muse leaves on the cloud server (default: on on your Mac, off when hosted)
# CLOUD_DEFAULT_CALENDAR=Personal # where an event goes when no calendar fits; unset = Cipher asks
# TIMEZONE=America/New_York       # your time zone (default: this Mac's)
# The stronger model that answers when you ask for something to be done (calendar,
# tasks, deadlines). Conversation stays on ANTHROPIC_MODEL. "off" to use one model.
# ANTHROPIC_TOOL_MODEL=claude-sonnet-5-5
# WORKER_MODEL=claude-opus-5-5 # multi-step background work; claude-fable-5-1 also works
